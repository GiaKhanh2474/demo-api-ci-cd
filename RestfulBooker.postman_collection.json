{
  "info": {
    "name": "RestfulBooker API Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Positive_Cases",
      "item": [
        {
          "name": "Request 1 - Valid Authentication",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Đăng nhập thành công (Status 200)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.environment.set(\"token\", jsonData.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"admin\",\n    \"password\": \"password123\"\n}"
            },
            "url": "https://restful-booker.herokuapp.com/auth"
          }
        },
        {
          "name": "Request 2 - Create Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Tạo booking thành công (Status 200)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "var expectedFirstName = pm.iterationData.get(\"firstname\");",
                  "if (expectedFirstName) {",
                  "    pm.test(\"Tên khách hàng khớp với dữ liệu đầu vào\", function () {",
                  "        pm.expect(jsonData.booking.firstname).to.eql(expectedFirstName);",
                  "    });",
                  "}",
                  "pm.environment.set(\"bookingid\", jsonData.bookingid);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"firstname\": \"{{firstname}}\",\n    \"lastname\": \"{{lastname}}\",\n    \"totalprice\": {{totalprice}},\n    \"depositpaid\": {{depositpaid}},\n    \"bookingdates\": {\n        \"checkin\": \"{{checkin}}\",\n        \"checkout\": \"{{checkout}}\"\n    },\n    \"additionalneeds\": \"{{additionalneeds}}\"\n}"
            },
            "url": "https://restful-booker.herokuapp.com/booking"
          }
        },
        {
          "name": "Request 3 - Get Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Lấy thông tin thành công (Status 200)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "https://restful-booker.herokuapp.com/booking/{{bookingid}}"
          }
        },
        {
          "name": "Request 4 - Clean Data",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Xóa thành công (Status 201 Created)\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Cookie", "value": "token={{token}}" }
            ],
            "url": "https://restful-booker.herokuapp.com/booking/{{bookingid}}"
          }
        }
      ]
    },
    {
      "name": "Negative_Cases",
      "item": [
        {
          "name": "Request 5 - Invalid Authorization",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Hệ thống chặn truy cập (Status 403 Forbidden)\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "pm.test(\"Nội dung phản hồi là chữ Forbidden\", function () {",
                  "    pm.expect(pm.response.text()).to.eql(\"Forbidden\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "https://restful-booker.herokuapp.com/booking/{{bookingid}}"
          }
        },
        {
          "name": "Request 6 - Invalid Authentication",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code vẫn là 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Hệ thống từ chối cấp token (Bad credentials)\", function () {",
                  "    pm.expect(jsonData.reason).to.eql(\"Bad credentials\");",
                  "    pm.expect(jsonData).to.not.have.property(\"token\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"admin\",\n    \"password\": \"wrongpassword123\"\n}"
            },
            "url": "https://restful-booker.herokuapp.com/auth"
          }
        },
        {
          "name": "Request 7 - Invalid Input Data",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Máy chủ không xử lý được dữ liệu thiếu (Status 500)\", function () {",
                  "    pm.response.to.have.status(500);",
                  "});",
                  "pm.test(\"Nội dung báo lỗi Internal Server Error\", function () {",
                  "    pm.expect(pm.response.text()).to.include(\"Internal Server Error\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"firstname\": \"Hacker\",\n    \"lastname\": \"Test\"\n}"
            },
            "url": "https://restful-booker.herokuapp.com/booking"
          }
        }
      ]
    }
  ]
}